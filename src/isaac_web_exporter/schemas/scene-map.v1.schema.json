{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/isaac-web-exporter/scene-map.v1.schema.json",
  "title": "Isaac Replay object catalog v1.0",
  "type": "object",
  "required": ["schemaVersion", "objects", "animation"],
  "properties": {
    "schemaVersion": {"const": "v1.0"},
    "objects": {"type": "array", "items": {"type": "object", "required": ["id", "displayName", "sourcePrimPath", "parentId", "nodeIndices"], "properties": {
      "id": {"type": "string", "minLength": 1},
      "displayName": {"type": "string"},
      "sourcePrimPath": {"type": "string"},
      "parentId": {"type": ["string", "null"]},
      "nodeIndices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
    }}},
    "animation": {"type": "object", "required": ["durationSeconds"], "properties": {"durationSeconds": {"type": "number", "minimum": 0}}}
  }
}
